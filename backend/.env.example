# Obligatoire : générez une valeur aléatoire unique avant le déploiement.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Connexion PostgreSQL du service db dans docker-compose.yml
POSTGRES_DB=innovevent
POSTGRES_USER=innovevent
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis du service redis dans docker-compose.yml
REDIS_URL=redis://redis:6379/0

# Fichiers téléversés (photos, documents) : le serveur web doit publier
# MEDIA_URL vers MEDIA_ROOT. En Docker, conserver les valeurs par défaut.
# Sur cPanel, utilisez un chemin absolu persistant de votre compte.
MEDIA_URL=/media/
MEDIA_ROOT=

# Administrateur initial : obligatoire seulement tant qu'aucun super-administrateur
# actif n'existe. Utilisez un mot de passe unique, robuste et non versionné.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@votre-domaine.example
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=Administrateur
INITIAL_ADMIN_LAST_NAME=InnovEvent

# À remplacer par le domaine HTTPS du déploiement
# Origines exactes de l'application (ajouter http://localhost:5173 pour Vite en dev)
CORS_ALLOWED_ORIGINS=https://votre-domaine.example

# Email transactionnel (facultatif tant que le SMTP n'est pas configuré)
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@votre-domaine.example

# Paiements : la simulation doit rester désactivée en production.
# Activez-la explicitement (True) uniquement en développement/démonstration.
PAYMENTS_DEMO_MODE=False
PAYMENT_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
FREEMOPAY_API_KEY=
KOB_API_KEY=

# Services optionnels
AI_PROVIDER=demo
AI_PROVIDER_API_KEY=
QR_SIGNING_SECRET=replace-with-another-long-random-secret
MESSAGING_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
